-- Moush needs ydotool installed and running, or clicking, dragging and
-- scrolling do nothing at all -- silently. The pointer still moves without it.
--   sudo pacman -S ydotool && systemctl --user enable --now ydotool
--
-- Moush: SUPER + M enters. A short press starts the session when the chord is
-- released and it ends after idle_ms; holding it past 500ms starts the session
-- right then and latches until you hit SUPER + M again.
--
-- The layouts, the bindings and the key-name reference all live in the plugin,
-- in implementation.lua. This calls it.

require("omarchy.plugins.hanoixan-moush.implementation")()

-- Pass a table to change anything. Top-level keys replace the default outright.
-- Under `modes`, a name that already exists has only the fields you give it
-- replaced; a name that does not exist is a new layout and has to be complete.
--
-- require("omarchy.plugins.hanoixan-moush.implementation")({
--   coarse_mod = "ALT",
--   idle_ms    = 3000,
--   modes = {
--     mash = { wheel = "G" },
--   },
-- })
