-- Mouse keys: SUPER + M enters. A short press starts the session when the chord
-- is released and it exits after 2s idle; holding it past 500ms starts the
-- session right then and latches until you hit SUPER + M again.
hl.bind("SUPER + M", hl.dsp.global("mousekeys:toggle"),
  { submap_universal = true, description = "Mouse keys" })

-- Timing the plugin needs but Hyprland has no option for. Hyprland keeps its Lua
-- globals across config loads, so the plugin reads this table back over
-- `hyprctl repl` when a session starts — which means hyprctl reload is enough to
-- apply a change, no shell restart.
--
--   fast_tap_ms  re-pressing the same key quicker than this is a "double tap":
--                a move key skitters to the next window edge or corner instead
--                of stepping, and a scroll key runs to the top or bottom of the
--                view. Must stay under input:repeat_delay (250ms), or a held
--                key's first auto-repeat would read as a deliberate re-press.
--
--   carry_ms     press a direction within this of the last moment a move key was
--                down and the speed already built up carries over, instead of
--                accelerating from rest again. Covers letting go of one arrow a
--                moment before pressing the next, which otherwise stalls until
--                the new key's first auto-repeat 250ms later. Independent of
--                fast_tap_ms; they start out equal only by coincidence.
--   mash_strategy          how mash turns key presses into one direction and
--                          speed. All of them read the same press trail:
--                            cpa   fit each 3 presses to the axis where the two
--                                  velocities are most equal and largest, then
--                                  average those (the original)
--                            lsq   least squares of position against time; the
--                                  slope is the velocity. Steadiest all-rounder
--                            net   first press to last over elapsed time; calm,
--                                  blind to the path between, slow to turn
--                            pca   dominant axis of the positions, speed from
--                                  distance along it. The only one that reads
--                                  mashing back and forth on one line as motion
--                            ewma  every hop's velocity, newest weighted most;
--                                  turns fastest, twitchiest
--   mash_debug_strategies  also computed and drawn in the debug view for
--                          comparison, whether or not they are steering. Each
--                          gets a colour and dash pattern from its own name.
MOUSEKEYS = {
  fast_tap_ms = 135,
  carry_ms = 175,
  mash_strategy = "pca",
  mash_debug_strategies = "cpa,lsq,pca,ewma",
}

-- Each keymap is a submap. The binds name ACTIONS, not keys, so remapping is a
-- one-line edit here and needs no change to the plugin — and adding a fourth
-- keymap is just another call plus its name in shell.json.
--
-- move/scroll keys repeat so a held key sweeps; buttons and cycle fire once.
-- ignore_mods keeps the key reaching the plugin whatever you are holding, which
-- is also what lets Shift+scroll be horizontal and Ctrl+scroll zoom in the app.
-- Scroll keys additionally bind their RELEASE, because a wheel event cancels
-- Hyprland's key repeat, so the plugin cannot see the key is still down; a
-- `release = true` bind will not dispatch a global shortcut, so it calls back in.
local function mousekeys_map(name, k)
  -- Published so the plugin can ask which direction keys are physically down.
  -- Hyprland cancels key repeat when any key is released and never hands it back
  -- to a key still held, so repeats alone cannot tell that the other arrow is
  -- still pressed, and a release bind does not fire once two bound keys are down.
  -- The plugin evaluates hl.is_key_down against these, which is why the keys live
  -- here and not there: is_key_down needs exact X keysyms and this is the only
  -- place that knows what the keys are.
  MOUSEKEYS.keys = MOUSEKEYS.keys or {}
  MOUSEKEYS.keys[name] = k
  hl.define_submap("mousekeys-" .. name, function()
    hl.bind("CTRL + ALT + Escape", hl.dsp.submap("reset"))          -- emergency exit
    for action, key in pairs({ up = k.up, down = k.down, left = k.left, right = k.right }) do
      hl.bind(key, hl.dsp.global("mousekeys:" .. action), { repeating = true, ignore_mods = true })
    end
    for action, key in pairs({ scrollup = k.scrollup, scrolldown = k.scrolldown }) do
      hl.bind(key, hl.dsp.global("mousekeys:" .. action), { repeating = true, ignore_mods = true })
      hl.bind(key, hl.dsp.exec_cmd("omarchy-shell -q shell call mousekeys scrollstop ''"),
        { release = true, ignore_mods = true })
    end
    for action, key in pairs({ lmb = k.lmb, mmb = k.mmb, rmb = k.rmb }) do
      hl.bind(key, hl.dsp.global("mousekeys:" .. action), { ignore_mods = true })
    end
    hl.bind(k.cycle or "TAB", hl.dsp.global("mousekeys:cycle"), { ignore_mods = true })
  end)
end

-- "mash" is a different kind of navigation: the keys below form a grid on the
-- right half of the keyboard, and mashing across them rolls the pointer like a
-- trackball. Which key sits where is a *binding*, so the grid is described here:
-- each action is named "m<x2>_<y>", where y is the row and x2 is the column in
-- half-key steps, because the rows are staggered by half a key. Halving x makes
-- one column step and one row step the same distance, so 7 -> 0 and 7 -> N both
-- measure 3, as they do under your fingers.
--
--    7 8 9 0 -          y=0, x2 = 1 3 5 7 9
--   Y U I O P [         y=1, x2 = 0 2 4 6 8 10
--   H J K L ; '         y=2, x2 = 0 2 4 6 8 10
--    N M , . /          y=3, x2 = 1 3 5 7 9
--
-- Re-measuring this for a differently-staggered keyboard is an edit here alone.
local mash_grid = {
  { y = 0, keys = { ["7"] = 1, ["8"] = 3, ["9"] = 5, ["0"] = 7, minus = 9 } },
  { y = 1, keys = { Y = 0, U = 2, I = 4, O = 6, P = 8, bracketleft = 10 } },
  { y = 2, keys = { H = 0, J = 2, K = 4, L = 6, semicolon = 8, apostrophe = 10 } },
  { y = 3, keys = { N = 1, M = 3, comma = 5, period = 7, slash = 9 } },
}

-- Struck by accident while reaching for the grid, so they are bound to nothing
-- rather than left to fall through to whatever is underneath.
local mash_null = { "5", "6", "R", "T", "F", "G", "V", "B" }

local function mousekeys_mash()
  MOUSEKEYS.keys = MOUSEKEYS.keys or {}
  MOUSEKEYS.keys.mash = { wheel = "W", labels = {} }   -- wheel is polled; labels
  local labels = MOUSEKEYS.keys.mash.labels             -- name the debug display's cells
  hl.define_submap("mousekeys-mash", function()
    hl.bind("CTRL + ALT + Escape", hl.dsp.submap("reset"))
    for _, row in ipairs(mash_grid) do
      for key, x2 in pairs(row.keys) do
        labels["m" .. x2 .. "_" .. row.y] = key
        -- Not repeating: a held key would restrike the same point forever, and
        -- only key-down is meant to steer the ball.
        hl.bind(key, hl.dsp.global("mousekeys:m" .. x2 .. "_" .. row.y), { ignore_mods = true })
      end
    end
    for _, key in ipairs(mash_null) do
      hl.bind(key, hl.dsp.global("mousekeys:noop"), { ignore_mods = true })
    end
    hl.bind("A", hl.dsp.global("mousekeys:rmb"), { ignore_mods = true })
    hl.bind("S", hl.dsp.global("mousekeys:mmb"), { ignore_mods = true })
    hl.bind("D", hl.dsp.global("mousekeys:lmb"), { ignore_mods = true })
    hl.bind("W", hl.dsp.global("mousekeys:wheel"), { repeating = true, ignore_mods = true })
    hl.bind("TAB", hl.dsp.global("mousekeys:cycle"), { ignore_mods = true })
    hl.bind("grave", hl.dsp.global("mousekeys:debug"), { ignore_mods = true })
  end)
end
mousekeys_mash()

mousekeys_map("left", {
  up = "I", down = "K", left = "J", right = "L",
  lmb = "C", mmb = "X", rmb = "Z", scrollup = "Y", scrolldown = "H",
})
mousekeys_map("right", {
  up = "W", down = "S", left = "A", right = "D",
  lmb = "comma", mmb = "period", rmb = "slash", scrollup = "R", scrolldown = "F",
})
mousekeys_map("arrows", {
  up = "UP", down = "DOWN", left = "LEFT", right = "RIGHT",
  lmb = "D", mmb = "S", rmb = "A", scrollup = "Prior", scrolldown = "Next",
})
