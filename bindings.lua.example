-- Moush: SUPER + M enters. A short press starts the session when the chord
-- is released and it exits after 2s idle; holding it past 500ms starts the
-- session right then and latches until you hit SUPER + M again.
--
-- Everything the plugin knows about keys lives here. Each mode is a submap and a
-- key layout; the cycle key moves between them and the choice persists. Tunables sit at the
-- top level and any mode may override one by naming it.
MOUSH = {
  -- The chord that opens a session. The chord_hl_bind used with the bind near the 
  -- bottom of this file is what Hyprland acts on; 
  -- these are the same keys written as X keysyms, which Moush
  -- needs in order to tell a tap from a hold by asking whether the chord is still
  -- down. Change them together. Either list may hold several syms and any one
  -- counts, which is how both Super keys and the shifted M are covered.
  -- They are two different settings because the key codes are done in different ways.
  chord_mods = { "Super_L", "Super_R" },
  chord_key  = { "m", "M" },
  chord_hl_bind = "SUPER + M",

  -- ---- timing ------------------------------------------------------------
  carry_ms    = 175,   -- press a direction this soon after another to keep its speed
  idle_ms     = 1500,  -- a tapped session ends after this long with no input

  -- Held while you press a grid key. Coarse means "bigger": a single press moves
  -- further, a swipe goes all the way to the next edge. Fine means "smaller".
  -- Any Hyprland modifier name works; holding both counts as fine.
  coarse_mod  = "SHIFT",
  fine_mod    = "CTRL",

  -- Not part of a layout: these do the same thing whichever one is active, so they
  -- are declared once here. A mode may still name its own to override.
  cycle    = "F2",       -- next mode
  debug    = "F1",       -- the overlay

  -- ---- the trackball -----------------------------------------------------
  mash_gain    = 0.25,   -- impulse per (unit/s)^3 in each mode's coordinate space
  mash_vmax    = 2000,   -- px/s ceiling, and so the longest throw: vmax/3 pixels
  mash_samples = 4,      -- presses a fit may see

  -- ---- scrolling, while the wheel key is held -----------------------------
  scroll_repeat_scale_min   = 1,      -- detents per repeat to begin with
  scroll_repeat_scale_max   = 10,     -- once the ramp runs out, and what a coarse press asks for
  scroll_repeat_scale_ultra = 100,    -- a coarse swipe asks for this at once
  scroll_increase_delay     = 1.5,    -- seconds flat before the ramp starts
  scroll_increase_time      = 5,      -- seconds the ramp takes
  scroll_repeat_ms          = 60,     -- between repeats

  modes = {
    mash = {
      keys = {
        -- key, x, y. Any coordinate space you like, as long as x grows rightward
        -- and y downward; mash_gain is what scales it to pixels. These are in key
        -- widths, with the rows staggered as the keyboard actually is.
        { "8", 0.5, 0 }, { "9", 1.5, 0 }, { "0", 2.5, 0 }, { "minus", 3.5, 0 }, { "equal", 4.5, 0 },
        { "U", 0.0, 2 }, { "I", 1.0, 2 }, { "O", 2.0, 2 }, { "P", 3.0, 2 }, { "bracketleft", 4.0, 2 },
        { "J", 0.0, 4 }, { "K", 1.0, 4 }, { "L", 2.0, 4 }, { "semicolon", 3.0, 4 }, { "apostrophe", 4.0, 4 },
        { "M", 0.5, 6 }, { "comma", 1.5, 6 }, { "period", 2.5, 6 }, { "slash", 3.5, 6 },
      },

      -- Struck alone, these steer instead of contributing to a sweep. Only then:
      -- during a sweep a key is just a point, and the direction comes from the
      -- gesture. The two lower diagonals are chosen for finger reach rather than
      -- for where they sit, so they do not match the grid geometry and are not
      -- meant to.
      dirs = {
        I = "up", K = "down", J = "left", L = "right",
        ["8"] = "upleft", ["9"] = "upright", U = "downleft", O = "downright",
      },

      -- Rule: dirs must be a subset of keys; buttons and wheel must not be in keys.
      -- wheel, buttons and anything in dirs are asked about while held, so they
      -- need a real keysym -- is_key_down knows nothing about "code:NN".

      buttons = { lmb = "space", mmb = "V", rmb = "B" },
      wheel    = "H",        -- held: the whole mode scrolls

      -- Bound to nothing, so a stray reach does not leak into the focused window.
      inert = { "N", "7", "Y", "G", "backslash", "bracketright" },
    },
    -- The same grid shape as mash, moved under the left hand rather than
    -- mirrored: the directional cluster still sits on the middle-finger column,
    -- so both hands steer by the same feel.
    ["mash_lh"] = {
      keys = {
        -- key, x, y. Same coordinate space and stagger as mash above, with Q as
        -- the origin instead of U.
        { "2", 0.5, 0 }, { "3", 1.5, 0 }, { "4", 2.5, 0 }, { "5", 3.5, 0 }, { "6", 4.5, 0 },
        { "Q", 0.0, 2 }, { "W", 1.0, 2 }, { "E", 2.0, 2 }, { "R", 3.0, 2 }, { "T", 4.0, 2 },
        { "A", 0.0, 4 }, { "S", 1.0, 4 }, { "D", 2.0, 4 }, { "F", 3.0, 4 }, { "G", 4.0, 4 },
        { "Z", 0.5, 6 }, { "X", 1.5, 6 }, { "C", 2.5, 6 }, { "V", 3.5, 6 },
      },

      -- Struck alone, these steer instead of contributing to a sweep. Only then:
      -- during a sweep a key is just a point, and the direction comes from the
      -- gesture. The two lower diagonals are chosen for finger reach rather than
      -- for where they sit, so they do not match the grid geometry and are not
      -- meant to.
      dirs = {
        W = "up", S = "down", A = "left", D = "right",
        ["2"] = "upleft", ["3"] = "upright", Q = "downleft", E = "downright",
      },

      -- Rule: dirs must be a subset of keys; buttons and wheel must not be in keys.
      -- wheel, buttons and anything in dirs are asked about while held, so they
      -- need a real keysym -- is_key_down knows nothing about "code:NN".

      buttons = { lmb = "space", mmb = "1", rmb = "B" },
      wheel    = "Tab",  -- held: the whole mode scrolls

      -- Bound to nothing, so a stray reach does not leak into the focused window.
      -- Caps Lock is by keycode: it emits Multi_key here, so its name never fires.
      inert = { "7", "Y", "H", "grave" },
    },
  },
}

-- The plugin asks for its settings through this, so the merge of a mode's
-- overrides onto the top-level defaults happens once, here, rather than being
-- reimplemented on the other side.
function MOUSH_SETTINGS(mode)
  local m = MOUSH
  local md = (m.modes or {})[mode] or {}
  local function g(k)
    if md[k] ~= nil then return md[k] end
    return m[k]
  end
  local out = {}
  local function put(k, v) out[#out + 1] = k .. "=" .. tostring(v == nil and "" or v) end

  for _, k in ipairs({ "carry_ms", "idle_ms", "coarse_mod", "fine_mod", "mash_gain", "mash_vmax",
                       "mash_samples",
                       "scroll_repeat_scale_min", "scroll_repeat_scale_max",
                       "scroll_repeat_scale_ultra", "scroll_increase_delay",
                       "scroll_increase_time", "scroll_repeat_ms" }) do
    put(k, g(k))
  end

  -- index:key:x:y, in the order declared, which is the index the binds use
  local keys = {}
  for i, e in ipairs(md.keys or {}) do
    keys[#keys + 1] = (i - 1) .. ":" .. e[1] .. ":" .. e[2] .. ":" .. e[3]
  end
  put("keys", table.concat(keys, ","))

  -- index:direction, for the keys that steer when struck alone
  local dirs = {}
  for i, e in ipairs(md.keys or {}) do
    local d = (md.dirs or {})[e[1]]
    if d then dirs[#dirs + 1] = (i - 1) .. ":" .. d end
  end
  put("dirs", table.concat(dirs, ","))

  local names = {}
  for name in pairs(m.modes or {}) do names[#names + 1] = name end
  table.sort(names)
  put("modes", table.concat(names, ","))

  -- Keysyms, for the two things the plugin needs them for: asking whether a held
  -- key is still down, and labelling the key in the debug overlay.
  local b = md.buttons or {}
  put("lmb", b.lmb); put("mmb", b.mmb); put("rmb", b.rmb)
  put("wheel", md.wheel)
  put("cycle", g("cycle")); put("debug", g("debug"))
  put("chord_key", table.concat(m.chord_key or {}, ","))
  put("chord_mods", table.concat(m.chord_mods or {}, ","))
  return table.concat(out, " ")
end

-- Bind the chord
hl.bind(MOUSH.chord_hl_bind, hl.dsp.global("moush:toggle"),
  { submap_universal = true, description = "Moush" })

-- Mouse mode binds each key once per modifier combination that should reach it.
-- SUPER and ALT are deliberately absent, so a key held with either matches nothing
-- here and goes to the focused application instead. ignore_mods cannot express
-- that: it fires whatever is held, and an explicit "SUPER + key" no-op alongside
-- it loses to it, in either declaration order.
-- Each grid key is bound once per modifier combination, to a *different* action,
-- so the press itself carries which modifier was held. Asking the compositor
-- instead would cost a round trip of about 150ms per press, far longer than the
-- gap between two presses of a swipe.
--
-- SUPER and ALT are deliberately absent, so those combinations still reach your
-- normal bindings while a session is open.
local function moush_mods()
  local c = MOUSH.coarse_mod or "SHIFT"
  local f = MOUSH.fine_mod or "CTRL"
  return {
    { pre = "",                       kind = "" },
    { pre = c .. " + ",               kind = "c" },
    { pre = f .. " + ",               kind = "f" },
    { pre = c .. " + " .. f .. " + ", kind = "f" },   -- both held: fine wins
  }
end

-- Aux keys mean the same thing whatever is held, so a modifier still rides along
-- to the application: SHIFT with a mouse button is still a shift-click.
local function moush_bind(key, dispatcher, opts)
  -- A mode may leave any of these out, and nil must skip rather than throw: an
  -- error here aborts the whole submap callback, silently losing every bind after
  -- the missing one.
  if key == nil or key == "" then return end
  for _, m in ipairs(moush_mods()) do
    hl.bind(m.pre .. key, dispatcher, opts)
  end
end

-- The physical keys behind a modifier name. Bound on their own as well as in the
-- combinations above, so pressing or releasing one while a key is already held
-- reaches the plugin: a held key's auto-repeat keeps the binding it started with
-- and says nothing about a modifier that has since changed.
local MOUSH_MOD_KEYS = {
  SHIFT = { "Shift_L", "Shift_R" },
  CTRL  = { "Control_L", "Control_R" },
  ALT   = { "Alt_L", "Alt_R" },
  SUPER = { "Super_L", "Super_R" },
}

local function moush_bind_mod(name, which)
  for _, key in ipairs(MOUSH_MOD_KEYS[name] or {}) do
    -- Press only. A release bind on a bare modifier does not fire dependably here,
    -- so letting go is noticed by asking, the same way every other held key is.
    hl.bind(key, hl.dsp.global("moush:" .. which .. "on"), {})
  end
end

local function moush_bind_grid(key, i, opts)
  if key == nil or key == "" then return end
  for _, m in ipairs(moush_mods()) do
    hl.bind(m.pre .. key, hl.dsp.global("moush:" .. m.kind .. "k" .. i), opts)
  end
end

local function moush_mode(name, cfg)
  hl.define_submap("moush-" .. name, function()
    hl.bind("CTRL + ALT + Escape", hl.dsp.submap("reset"))   -- emergency exit

    -- Grid keys are named by index, not by position, so the layout above can use
    -- any coordinates it likes without the plugin having to know them in advance.
    -- Repeating, so holding a direction key sweeps as an arrow would; the plugin
    -- reads a repeat as the same key still down rather than a fresh point.
    for i, e in ipairs(cfg.keys or {}) do
      moush_bind_grid(e[1], i - 1, { repeating = true })
    end

    local b = cfg.buttons or {}
    moush_bind(b.lmb, hl.dsp.global("moush:lmb"), {})
    moush_bind(b.mmb, hl.dsp.global("moush:mmb"), {})
    moush_bind(b.rmb, hl.dsp.global("moush:rmb"), {})
    moush_bind(cfg.wheel, hl.dsp.global("moush:wheel"), {})
    moush_bind(cfg.cycle or MOUSH.cycle, hl.dsp.global("moush:cycle"), {})
    moush_bind(cfg.debug or MOUSH.debug, hl.dsp.global("moush:debug"), {})

    moush_bind_mod(MOUSH.coarse_mod or "SHIFT", "coarse")
    moush_bind_mod(MOUSH.fine_mod or "CTRL", "fine")

    for _, key in ipairs(cfg.inert or {}) do
      moush_bind(key, hl.dsp.global("moush:noop"), {})
    end
  end)
end

for name, cfg in pairs(MOUSH.modes) do moush_mode(name, cfg) end

-- ---------------------------------------------------------------------------
-- Key names, for reference.
--
-- The keysym is the name of the key, and is what you write both in a binding
-- and anywhere Moush has to ask whether a key is still held. A binding may
-- carry modifiers in front of it -- "SUPER + M" -- and a modifier is written
-- there by its prefix, which is a different word from the keysym of the key
-- itself. That is the whole of the third column.
--
-- Which fields take which:
--   keys, buttons, wheel, inert      keysym
--   cycle, debug                     keysym
--   chord_key, chord_mods            keysym
--   chord_hl_bind                    keysym, with prefixes
--   coarse_mod, fine_mod             prefix
--
-- A * marks a key your keyboard may not have. The name is still valid and will
-- bind without complaint; nothing will ever press it.
--
-- description                keysym             prefix
-- letters, either case       a .. z             -
-- digits                     0 .. 9             -
-- backtick / tilde           grave              -
-- hyphen / underscore        minus              -
-- equals / plus              equal              -
-- left square bracket        bracketleft        -
-- right square bracket       bracketright       -
-- backslash / pipe           backslash          -
-- semicolon / colon          semicolon          -
-- apostrophe / quote         apostrophe         -
-- comma / less than          comma              -
-- period / greater than      period             -
-- slash / question           slash              -
-- space bar                  space              -
-- tab                        Tab                -
-- enter                      Return             -
-- backspace                  BackSpace          -
-- escape                     Escape             -
--
-- left shift                 Shift_L            SHIFT
-- right shift                Shift_R            SHIFT
-- left control               Control_L          CTRL
-- right control              Control_R          CTRL
-- left alt                   Alt_L              ALT
-- right alt                  Alt_R              ALT
-- left super                 Super_L            SUPER
-- right super                Super_R            SUPER
-- caps lock, Compose here    Multi_key          CAPS
--
-- arrow keys                 Left Right Up Down -
-- delete                     Delete             -
-- insert *                   Insert             -
-- home *                     Home               -
-- end *                      End                -
-- page up *                  Prior              -
-- page down *                Next               -
--
-- function keys              F1 .. F12          -
-- more function keys *       F19 F23 F24        -   F13 .. F18 report as XF86
-- menu / context *           Menu               -
-- print screen *             Print              -
-- scroll lock *              Scroll_Lock        -
-- pause / break *            Pause              -
-- num lock *                 Num_Lock           -
--
-- keypad digits *            KP_0 .. KP_9       -
-- keypad divide *            KP_Divide          -
-- keypad multiply *          KP_Multiply        -
-- keypad minus *             KP_Subtract        -
-- keypad plus *              KP_Add             -
-- keypad enter *             KP_Enter           -
-- keypad period *            KP_Decimal         -
-- keypad equals *            KP_Equal           -
-- with num lock off that block reports as KP_Insert KP_End KP_Down KP_Next
-- KP_Left KP_Begin KP_Right KP_Home KP_Up KP_Prior, and the period as KP_Delete
--
-- AltGr, non-US layouts *    ISO_Level3_Shift   -
-- level 5 shift *            ISO_Level5_Shift   -
-- extra key by left shift *  less               -
--
-- Japanese and Korean *      Katakana Hiragana Hiragana_Katakana Henkan_Mode
--                           Muhenkan Hangul Hangul_Hanja
--
-- Media, laptop and application keys, all of them * and none of them taking a
-- prefix. Whether any given one exists depends entirely on the keyboard:
--   Cancel Find Help Linefeed Redo SunFront SunProps Undo XF86AudioBassBoost
--   XF86AudioForward XF86AudioMedia XF86AudioMicMute XF86AudioMute
--   XF86AudioNext XF86AudioPause XF86AudioPlay XF86AudioPreset XF86AudioPrev
--   XF86AudioRecord XF86AudioRewind XF86AudioStop XF86Back XF86Battery
--   XF86Bluetooth XF86BrightnessAuto XF86Calculator XF86Close XF86Copy
--   XF86Cut XF86DOS XF86Display XF86DisplayOff XF86Documents XF86Eject
--   XF86Explorer XF86Favorites XF86Finance XF86Forward XF86Game XF86Go
--   XF86HomePage XF86KbdBrightnessDown XF86KbdBrightnessUp XF86KbdLightOnOff
--   XF86Launch1 XF86Launch2 XF86Launch3 XF86Launch4 XF86Launch5 XF86Launch6
--   XF86Launch7 XF86Launch8 XF86Launch9 XF86LaunchA XF86LaunchB XF86Mail
--   XF86MailForward XF86MenuKB XF86Messenger XF86MonBrightnessCycle
--   XF86MonBrightnessDown XF86MonBrightnessUp XF86MyComputer XF86New
--   XF86Next_VMode XF86Open XF86Paste XF86Phone XF86PowerOff XF86Prev_VMode
--   XF86RFKill XF86Reload XF86Reply XF86RotateWindows XF86Save
--   XF86ScreenSaver XF86ScrollDown XF86ScrollUp XF86Search XF86Send XF86Shop
--   XF86Sleep XF86Suspend XF86TaskPane XF86Tools XF86TouchpadOn
--   XF86TouchpadToggle XF86UWB XF86WLAN XF86WWAN XF86WWW XF86WakeUp
--   XF86WebCam XF86Xfer plusminus
--
-- Volume up and down are absent from this keymap entirely, so unlike the names
-- above they cannot be bound at all. XF86AudioMute is present.
--
-- The shifted name of a key is a different keysym and binds only with the shift
-- held: write comma, not less. Those are exclam at numbersign dollar percent
-- asciicircum ampersand asterisk parenleft parenright underscore plus braceleft
-- braceright bar colon quotedbl less greater question asciitilde.
--
-- A prefix has aliases: CTRL and CONTROL are one, ALT and MOD1 are one, and
-- SUPER, WIN, LOGO and MOD4 are all the same.
--
-- Caps lock is the one key whose binding is not simply its keysym. Omarchy sets
-- kb_options = compose:caps, so it is Compose: it reports as Multi_key, and a
-- binding written as Caps_Lock registers and never fires -- measured, six
-- presses, no session. Bind it as Multi_key or as code:66.
--
-- Anything can be bound as code:NN, where NN is the evdev code plus 8, but a
-- keycode cannot be asked about: is_key_down("code:66") answers nothing at all,
-- so a key that has to be polled reads as released the instant it is pressed.
-- That rules a keycode out for wheel, for buttons, and for anything in dirs.
--
-- The Fn key is handled by the keyboard itself and never reaches software.
-- ---------------------------------------------------------------------------
